# Nonsecret template for the separately managed Mac mini test Emby project.
# scripts/mac-mini-emby-test init writes ignored absolute output paths locally.
EMBY_TEST_CONFIG_VOLUME=emby-mac-test-config-v1
EMBY_TEST_MOVIES_PATH=/absolute/path/to/MediaRouter/.local/mac-mini/outputs/movies
EMBY_TEST_SERIES_PATH=/absolute/path/to/MediaRouter/.local/mac-mini/outputs/series
