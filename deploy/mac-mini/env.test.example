# Safe, non-secret defaults for the isolated Mac mini test project.
MAC_TEST_ENVIRONMENT=mac-mini-test
MAC_TEST_PROJECT=mediarouter-mac-test
MAC_TEST_API_PORT=18088
MAC_TEST_PUBLIC_URL=http://host.docker.internal:18088
MAC_TEST_EMBY_ALLOWED_HOSTS=host.docker.internal:8597,localhost:8597
MEDIA_ROUTER_SOURCE_ENTRY_SHADOW_LEDGER_ENABLED=false
MEDIA_ROUTER_GIT_BRANCH=test/mac-mini-integration-harness
MEDIA_ROUTER_GIT_COMMIT=Unavailable

# Create .local/mac-mini/secrets.env separately and chmod it 0600.
# Do not place Emby keys, provider credentials, or production locators here.
