#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PROJECT=emby-mac-test
SERVICE=emby
CONTAINER=MacEmbyTester
EXPECTED_ORIGINAL_ID=d6abf72ac521d48fea45eff4a54a7d60286115734e5f081e1211db79e3dad28f
ORIGINAL_VOLUME=be434b05f00eb341f06016c078d9b852990188a14ccead1884fdf2157061cc73
IMAGE='emby/embyserver@sha256:734a6f03c7c783a9e566b08d09a2b6376f41229ff29f032a7e00302e0be98f8a'
SERVER_ID=312374cb311f4fa28ba32489efc20e39
VERSION=4.9.5.0
MANAGED_VOLUME=emby-mac-test-config-v1
ENV_FILE="$REPO_ROOT/deploy/mac-mini/.env.emby.test"
COMPOSE_FILE="$REPO_ROOT/deploy/mac-mini/compose.emby.test.yml"
LOCAL_ROOT="$REPO_ROOT/.local/mac-mini/emby-test"
BACKUP_ROOT="$LOCAL_ROOT/backups"
EVIDENCE_ROOT="$LOCAL_ROOT/evidence"
STATE_FILE="$LOCAL_ROOT/replacement-state.json"
HELPER="$SCRIPT_DIR/mac_mini_emby.py"

usage() {
  echo "usage: scripts/mac-mini-emby-test {init|config|safety-check|status|backup --deployment legacy|backup --deployment managed|clone-config BACKUP|replace --confirm emby-mac-test-replace|verify|rollback --confirm emby-mac-test-rollback|logs}" >&2
  exit 2
}

compose() {
  docker compose -p "$PROJECT" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
}

volume_name() {
  value=$(awk -F= '$1=="EMBY_TEST_CONFIG_VOLUME" {print substr($0,index($0,"=")+1)}' "$ENV_FILE")
  python3 "$HELPER" validate-volume "$value"
}

ensure_initialized() {
  python3 "$SCRIPT_DIR/mac_mini_harness.py" validate-local-root "$REPO_ROOT/.local/mac-mini" "$REPO_ROOT"
  python3 "$HELPER" validate-local-root "$LOCAL_ROOT" "$REPO_ROOT"
  [ -f "$ENV_FILE" ] && [ ! -L "$ENV_FILE" ] || { echo "Run init first; local env must be a regular file." >&2; exit 1; }
  [ "$(stat -f %Lp "$ENV_FILE")" = "600" ] || { echo "Local env mode must be 0600." >&2; exit 1; }
  mkdir -p "$BACKUP_ROOT" "$EVIDENCE_ROOT"
  chmod 700 "$LOCAL_ROOT" "$BACKUP_ROOT" "$EVIDENCE_ROOT"
}

render() {
  ensure_initialized
  output=${1:-"$EVIDENCE_ROOT/compose.effective.json"}
  compose config --format json >"$output"
  python3 "$HELPER" validate-compose "$output" "$REPO_ROOT" "$(volume_name)"
  printf '%s\n' "$output"
}

original_guard() {
  output="$EVIDENCE_ROOT/original.inspect.json"
  temporary=$(mktemp "$LOCAL_ROOT/.original-inspect.XXXXXX")
  docker inspect "$CONTAINER" >"$temporary"
  python3 - "$temporary" <<'PY'
import json,sys
p=sys.argv[1]; d=json.load(open(p))[0]; json.dump(d,open(p,"w"))
PY
  python3 "$HELPER" validate-original-inspect "$temporary" "$EXPECTED_ORIGINAL_ID"
  python3 - "$temporary" "$output" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); c=d.get("Config") or {}; c["Env"]=[x.split("=",1)[0]+"=[redacted]" for x in c.get("Env") or []]; d["Config"]=c
json.dump(d,open(sys.argv[2],"w"),indent=2,sort_keys=True)
PY
  python3 -c 'from pathlib import Path; Path(__import__("sys").argv[1]).unlink(missing_ok=True)' "$temporary"
  [ "$(docker inspect -f '{{.State.Status}}' "$CONTAINER")" = "running" ] || {
    echo "Original container must be running before replacement begins." >&2; exit 1;
  }
  [ -z "$(docker ps -a --filter label=com.docker.compose.project=$PROJECT -q)" ] || {
    echo "A managed replacement project already exists." >&2; exit 1;
  }
}

stopped_original_guard() {
  temporary=$(mktemp "$LOCAL_ROOT/.stopped-original-inspect.XXXXXX")
  trap 'python3 -c '\''from pathlib import Path; import sys; Path(sys.argv[1]).unlink(missing_ok=True)'\'' "$temporary"' EXIT HUP INT TERM
  docker inspect "$CONTAINER" >"$temporary"
  python3 - "$temporary" <<'PY'
import json,sys
p=sys.argv[1]; d=json.load(open(p))[0]; json.dump(d,open(p,"w"))
PY
  python3 "$HELPER" validate-original-inspect "$temporary" "$EXPECTED_ORIGINAL_ID"
  [ "$(docker inspect -f '{{.State.Status}}' "$CONTAINER")" = "exited" ] || {
    echo "Backup requires the exact original container to be stopped." >&2; exit 1;
  }
  python3 -c 'from pathlib import Path; import sys; Path(sys.argv[1]).unlink(missing_ok=True)' "$temporary"
  trap - EXIT HUP INT TERM
}

backup_stopped() {
  stopped_original_guard
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  archive="$BACKUP_ROOT/config-$stamp.tar.gz"
  [ ! -e "$archive" ] && [ ! -L "$archive" ] || { echo "Backup already exists." >&2; exit 1; }
  python3 "$HELPER" validate-backup-location "$archive" "$BACKUP_ROOT"
  if ! docker run --rm --entrypoint /bin/sh \
    --mount "type=volume,src=$ORIGINAL_VOLUME,dst=/source,readonly" \
    --mount "type=bind,src=$BACKUP_ROOT,dst=/backup" \
    "$IMAGE" -c "umask 077; tar -czf /backup/$(basename "$archive") -C /source ."; then
    python3 -c 'from pathlib import Path; import sys; Path(sys.argv[1]).unlink(missing_ok=True)' "$archive"
    echo "Protected backup creation failed safely." >&2
    exit 1
  fi
  chmod 600 "$archive"
  if ! python3 "$HELPER" validate-backup "$archive" --sqlite >"$archive.metadata.json"; then
    python3 -c 'from pathlib import Path; import sys; p=Path(sys.argv[1]); p.unlink(missing_ok=True); Path(str(p)+".metadata.json").unlink(missing_ok=True)' "$archive"
    echo "Protected backup validation failed safely." >&2
    exit 1
  fi
  python3 - "$archive.metadata.json" "$ORIGINAL_VOLUME" "$stamp" "$IMAGE" <<'PY'
import json,sys
p=sys.argv[1]; d=json.load(open(p)); d.update(source_volume=sys.argv[2],timestamp=sys.argv[3],helper_image=sys.argv[4]); json.dump(d,open(p,"w"),indent=2,sort_keys=True); open(p,"a").write("\n")
PY
  chmod 600 "$archive.metadata.json"
  printf '%s\n' "$archive"
}

repository_backup_guard() {
  branch=$(git -C "$REPO_ROOT" branch --show-current)
  head=$(git -C "$REPO_ROOT" rev-parse HEAD)
  [ -n "$branch" ] && [ -n "$head" ] || {
    echo "Managed backup requires an attached Git branch and commit." >&2; exit 1;
  }
  git -C "$REPO_ROOT" merge-base --is-ancestor audit/emby-integration-wip "$head" || {
    echo "Managed backup HEAD must descend from audit/emby-integration-wip." >&2; exit 1;
  }
  [ -z "$(git -C "$REPO_ROOT" status --porcelain)" ] || {
    echo "Managed backup requires a clean working tree." >&2; exit 1;
  }
  case $(printf '%s' "$branch" | tr '[:upper:]' '[:lower:]') in
    *production*|*embyserver*) echo "Managed backup refuses a production-named branch." >&2; exit 1 ;;
  esac
  BACKUP_GIT_BRANCH=$branch
  BACKUP_GIT_HEAD=$head
}

validate_managed_backup_root() {
  python3 "$SCRIPT_DIR/mac_mini_harness.py" validate-local-root "$REPO_ROOT/.local/mac-mini" "$REPO_ROOT"
  python3 "$HELPER" validate-local-root "$LOCAL_ROOT" "$REPO_ROOT"
  [ -f "$ENV_FILE" ] && [ ! -L "$ENV_FILE" ] || {
    echo "Run init first; local env must be a regular file." >&2; exit 1;
  }
  [ "$(stat -f %Lp "$ENV_FILE")" = "600" ] || {
    echo "Local env mode must be 0600." >&2; exit 1;
  }
  [ -d "$BACKUP_ROOT" ] && [ ! -L "$BACKUP_ROOT" ] || {
    echo "Managed backup root must already be initialized." >&2; exit 1;
  }
  [ "$(stat -f %Lp "$LOCAL_ROOT")" = "700" ] && [ "$(stat -f %Lp "$BACKUP_ROOT")" = "700" ] || {
    echo "Managed backup root modes must be 0700." >&2; exit 1;
  }
}

capture_router_baseline() {
  destination=$1
  python3 - "$destination" "$REPO_ROOT/.local/mac-mini/outputs" <<'PY'
import hashlib,json,sys,urllib.request
from pathlib import Path
base="http://127.0.0.1:18088"
paths=("/api/catalog/summary","/api/jobs","/api/outputs/strm/history",
       "/api/outputs/live-m3u/history","/api/integrations/emby/channel-mappings",
       "/api/integrations/emby/bindings","/api/integrations/emby",
       "/api/broker/reservations")
result={}
for path in paths:
    with urllib.request.urlopen(base+path,timeout=10) as response:
        result[path]=json.load(response)
active=[job for job in result["/api/jobs"] if job.get("status") not in {"complete","failed","cancelled"}]
if active: raise SystemExit("MediaRouter has an active job; managed backup refused")
root=Path(sys.argv[2]); files=sorted((p for p in root.rglob("*") if p.is_file()),key=lambda p:p.relative_to(root).as_posix())
digest=hashlib.sha256()
for path in files:
    digest.update(path.relative_to(root).as_posix().encode()); digest.update(b"\0"); digest.update(path.read_bytes())
result["outputs"]={"file_count":len(files),"total_bytes":sum(p.stat().st_size for p in files),"digest":digest.hexdigest()}
Path(sys.argv[1]).write_text(json.dumps(result,sort_keys=True)+"\n")
PY
  chmod 600 "$destination"
}

capture_emby_identity() {
  python3 - "$SERVER_ID" "$VERSION" <<'PY'
import json,sys,urllib.request
expected_id,expected_version=sys.argv[1:3]
with urllib.request.urlopen("http://127.0.0.1:8597/System/Info/Public",timeout=10) as response:
    data=json.load(response)
if data.get("Id") != expected_id or data.get("Version") != expected_version:
    raise SystemExit("managed Emby identity mismatch before backup")
print(data["Id"]+" "+data["Version"])
PY
}

wait_router_polling() {
  python3 - "$SERVER_ID" "$VERSION" <<'PY'
import json,sys,time,urllib.request
expected_id,expected_version=sys.argv[1:3]
deadline=time.monotonic()+120
while True:
    try:
        with urllib.request.urlopen("http://127.0.0.1:18088/api/integrations/emby/status",timeout=10) as response:
            data=json.load(response)
        if (data.get("enabled") and data.get("health_state")=="healthy"
                and data.get("server_id")==expected_id and data.get("server_version")==expected_version
                and data.get("consecutive_failures")==0 and data.get("last_successful_poll")):
            break
    except Exception:
        pass
    if time.monotonic()>=deadline: raise SystemExit("MediaRouter Emby polling did not recover")
    time.sleep(2)
PY
}

managed_container_guard() {
  ids_file=$1
  inspect_file=$2
  compose ps -q "$SERVICE" | python3 -c 'import json,sys; print(json.dumps([line.strip() for line in sys.stdin if line.strip()]))' >"$ids_file"
  managed_id=$(python3 "$HELPER" validate-managed-service-ids "$ids_file")
  project_ids=$(docker ps --filter "label=com.docker.compose.project=$PROJECT" --format '{{.ID}}')
  [ "$(printf '%s\n' "$project_ids" | sed '/^$/d' | wc -l | tr -d ' ')" = "1" ] || {
    echo "Managed backup requires exactly one active project container." >&2; exit 1;
  }
  docker inspect "$managed_id" >"$inspect_file.array"
  python3 - "$inspect_file.array" "$inspect_file" <<'PY'
import json,sys
data=json.load(open(sys.argv[1]))
if len(data)!=1: raise SystemExit("managed container inspect was ambiguous")
json.dump(data[0],open(sys.argv[2],"w"),sort_keys=True)
PY
  python3 "$HELPER" validate-replacement-inspect "$inspect_file" "$(volume_name)" "$REPO_ROOT" "$managed_id"
  [ "$(docker inspect -f '{{.State.Status}}' "$managed_id")" = "running" ] || {
    echo "Managed backup requires the Compose service to be running." >&2; exit 1;
  }
  MANAGED_CONTAINER_ID=$managed_id
  MANAGED_IMAGE_ID=$(docker inspect -f '{{.Image}}' "$managed_id")
  MANAGED_RESTART_COUNT=$(docker inspect -f '{{.RestartCount}}' "$managed_id")
}

managed_backup() {
  repository_backup_guard
  validate_managed_backup_root
  [ "$(volume_name)" = "$MANAGED_VOLUME" ] || {
    echo "Managed backup requires the approved stable config volume." >&2; exit 1;
  }
  ids_file=
  inspect_file=
  baseline_before=
  baseline_after=
  metadata_temporary=
  archive=
  metadata=
  backup_claim=
  backup_claim_owned=false
  archive_validated=false
  managed_needs_restart=false
  managed_backup_exit() {
    status=$?
    trap - EXIT
    trap '' HUP INT TERM
    if [ "$managed_needs_restart" = true ]; then
      compose start "$SERVICE" >/dev/null 2>&1 || echo "Best-effort managed Emby restart failed." >&2
    fi
    if [ "$archive_validated" != true ]; then
      claim_option=
      [ "$backup_claim_owned" != true ] || claim_option=--claim-owned
      python3 "$HELPER" cleanup-unpublished-backup \
        "$archive" "$metadata" "$metadata_temporary" "$BACKUP_ROOT" $claim_option \
        >/dev/null 2>&1 || echo "Managed backup artifact cleanup failed; exact current paths may remain." >&2
    elif [ "$backup_claim_owned" = true ]; then
      python3 -c 'from pathlib import Path; import sys; Path(sys.argv[1]).unlink(missing_ok=True)' \
        "$metadata_temporary" >/dev/null 2>&1 || echo "Managed backup temporary metadata cleanup failed." >&2
    fi
    python3 -c 'from pathlib import Path; import sys; [Path(p).unlink(missing_ok=True) for p in sys.argv[1:] if p]' \
      "$ids_file" "$inspect_file" "$inspect_file.array" "$baseline_before" "$baseline_after" \
      >/dev/null 2>&1 || true
    if [ "$backup_claim_owned" = true ] && ! rmdir "$backup_claim" >/dev/null 2>&1; then
      echo "Managed backup claim cleanup failed: $backup_claim" >&2
    fi
    exit "$status"
  }
  trap managed_backup_exit EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  archive="$BACKUP_ROOT/managed-config-$stamp.tar.gz"
  metadata="$archive.metadata.json"
  backup_claim="$BACKUP_ROOT/.managed-config-$stamp.lock"
  [ ! -e "$archive" ] && [ ! -L "$archive" ] && [ ! -e "$metadata" ] && [ ! -L "$metadata" ] || {
    echo "Managed backup destination already exists." >&2; exit 1;
  }
  python3 "$HELPER" acquire-backup-claim "$backup_claim" "$BACKUP_ROOT"
  backup_claim_owned=true
  render >/dev/null
  ids_file=$(mktemp "$LOCAL_ROOT/.managed-ids.XXXXXX")
  inspect_file=$(mktemp "$LOCAL_ROOT/.managed-inspect.XXXXXX")
  baseline_before=$(mktemp "$LOCAL_ROOT/.router-baseline-before.XXXXXX")
  baseline_after=$(mktemp "$LOCAL_ROOT/.router-baseline-after.XXXXXX")
  metadata_temporary=$(mktemp "$BACKUP_ROOT/.managed-metadata.XXXXXX")
  python3 "$HELPER" validate-backup-location "$archive" "$BACKUP_ROOT"
  managed_container_guard "$ids_file" "$inspect_file"
  pre_identity=$(capture_emby_identity)
  capture_router_baseline "$baseline_before"
  "$SCRIPT_DIR/mac-mini-test" smoke >/dev/null
  scripts_before_runtime=$(docker logs mediarouter-mac-test-app 2>&1 | grep -Ec '(GET|POST) /r/(movie|episode)/' || true)
  scripts_before_locks=$(docker logs mediarouter-mac-test-app 2>&1 | grep -Eic 'database is locked|traceback' || true)
  managed_needs_restart=true
  compose stop -t 60 "$SERVICE" >/dev/null
  [ "$(docker inspect -f '{{.State.Status}}' "$MANAGED_CONTAINER_ID")" = "exited" ] || {
    echo "Managed Emby did not fully stop before backup." >&2; exit 1;
  }
  if ! docker run --rm --entrypoint /bin/sh \
    --mount "type=volume,src=$(volume_name),dst=/source,readonly" \
    --mount "type=bind,src=$BACKUP_ROOT,dst=/backup" \
    "$IMAGE" -c "umask 077; tar -czf /backup/$(basename "$archive") -C /source ."; then
    python3 -c 'from pathlib import Path; import sys; Path(sys.argv[1]).unlink(missing_ok=True)' "$archive"
    echo "Managed config archive creation failed." >&2
    exit 1
  fi
  chmod 600 "$archive"
  chmod 600 "$metadata_temporary"
  if ! python3 "$HELPER" validate-backup "$archive" --require-emby --sqlite >"$metadata_temporary"; then
    echo "Managed config archive validation failed." >&2
    exit 1
  fi
  python3 - "$metadata_temporary" "$stamp" "$MANAGED_CONTAINER_ID" "$MANAGED_IMAGE_ID" "$(volume_name)" "$(basename "$archive")" "$BACKUP_GIT_BRANCH" "$BACKUP_GIT_HEAD" <<'PY'
import json,sys
path=sys.argv[1]; data=json.load(open(path))
keys=("timestamp","container_id","image_id","volume_name","archive_filename","git_branch","git_head")
data.update(dict(zip(keys,sys.argv[2:])))
data.update(backup_mode="managed",backup_status="validated",
            compose_project="emby-mac-test",compose_service="emby",
            helper_image="emby/embyserver@sha256:734a6f03c7c783a9e566b08d09a2b6376f41229ff29f032a7e00302e0be98f8a")
with open(path,"w") as handle: json.dump(data,handle,indent=2,sort_keys=True); handle.write("\n")
PY
  python3 "$HELPER" publish-metadata "$metadata_temporary" "$metadata" "$BACKUP_ROOT"
  archive_validated=true
  compose start "$SERVICE" >/dev/null
  verify_replacement >/dev/null
  wait_router_polling
  "$SCRIPT_DIR/mac-mini-test" smoke >/dev/null
  managed_needs_restart=false
  post_id=$(compose ps -q "$SERVICE")
  [ "$post_id" = "$MANAGED_CONTAINER_ID" ] || {
    echo "Managed Emby container identity changed across backup." >&2; exit 1;
  }
  post_restart_count=$(docker inspect -f '{{.RestartCount}}' "$post_id")
  capture_router_baseline "$baseline_after"
  cmp -s "$baseline_before" "$baseline_after" || {
    echo "MediaRouter authoritative baseline changed during managed backup." >&2; exit 1;
  }
  scripts_after_runtime=$(docker logs mediarouter-mac-test-app 2>&1 | grep -Ec '(GET|POST) /r/(movie|episode)/' || true)
  scripts_after_locks=$(docker logs mediarouter-mac-test-app 2>&1 | grep -Eic 'database is locked|traceback' || true)
  [ "$scripts_after_runtime" = "$scripts_before_runtime" ] || { echo "Runtime requests occurred during managed backup." >&2; exit 1; }
  [ "$scripts_after_locks" = "$scripts_before_locks" ] || { echo "Database lock or traceback count changed during managed backup." >&2; exit 1; }
  echo "Managed backup passed: archive=$archive metadata=$metadata container_id=$post_id restart_count=$post_restart_count identity=$pre_identity polling=healthy"
  python3 -c 'from pathlib import Path; import sys; [Path(p).unlink(missing_ok=True) for p in sys.argv[1:]]' \
    "$ids_file" "$inspect_file" "$inspect_file.array" "$baseline_before" "$baseline_after" \
    >/dev/null 2>&1 || true
  if ! rmdir "$backup_claim" >/dev/null 2>&1; then
    echo "Managed backup claim cleanup failed: $backup_claim" >&2
  fi
  backup_claim_owned=false
  trap - EXIT HUP INT TERM
}

clone_from_backup() {
  archive=$1
  python3 "$HELPER" validate-backup-location "$archive" "$BACKUP_ROOT"
  [ -f "$archive" ] || { echo "Backup archive is missing." >&2; exit 1; }
  python3 "$HELPER" validate-backup "$archive" --sqlite >/dev/null
  target=$(volume_name)
  [ -z "$(docker volume ls -q --filter name=^${target}$)" ] || {
    echo "Clone volume already exists; refusing ambiguous resume." >&2; exit 1;
  }
  docker volume create --label mediarouter.environment=mac-mini-test --label mediarouter.purpose=emby-config "$target" >/dev/null
  if ! docker run --rm --entrypoint /bin/sh \
    --mount "type=bind,src=$(dirname "$archive"),dst=/backup,readonly" \
    --mount "type=volume,src=$target,dst=/target" \
    "$IMAGE" -c "tar -xzpf /backup/$(basename "$archive") -C /target"; then
    echo "Config clone failed; retained the new volume for diagnosis." >&2
    exit 1
  fi
  verify_archive="$BACKUP_ROOT/.clone-verify-$$.tar.gz"
  trap 'python3 -c '\''from pathlib import Path; import sys; Path(sys.argv[1]).unlink(missing_ok=True); Path(sys.argv[1]+".json").unlink(missing_ok=True)'\'' "$verify_archive"' EXIT HUP INT TERM
  docker run --rm --entrypoint /bin/sh \
    --mount "type=volume,src=$target,dst=/source,readonly" \
    --mount "type=bind,src=$BACKUP_ROOT,dst=/backup" \
    "$IMAGE" -c "umask 077; tar -czf /backup/$(basename "$verify_archive") -C /source ."
  chmod 600 "$verify_archive"
  python3 "$HELPER" validate-backup "$verify_archive" --sqlite >"$verify_archive.json"
  python3 - "$archive.metadata.json" "$verify_archive.json" <<'PY'
import json,sys
a=json.load(open(sys.argv[1])); b=json.load(open(sys.argv[2]))
if (a["file_count"],a["total_bytes"]) != (b["file_count"],b["total_bytes"]): raise SystemExit("cloned volume file count or size mismatch")
if not b.get("sqlite_integrity") or any(v != "ok" for v in b["sqlite_integrity"].values()): raise SystemExit("cloned volume SQLite integrity failed")
PY
  python3 -c 'from pathlib import Path; import sys; Path(sys.argv[1]).unlink(missing_ok=True); Path(sys.argv[1]+".json").unlink(missing_ok=True)' "$verify_archive"
  trap - EXIT HUP INT TERM
}

rollback_internal() {
  rollback_name=$1
  compose stop -t 60 "$SERVICE" >/dev/null 2>&1 || true
  compose down >/dev/null 2>&1 || true
  if docker ps -a --format '{{.Names}}' | grep -Fxq "$rollback_name"; then
    docker rename "$rollback_name" "$CONTAINER"
    docker start "$CONTAINER" >/dev/null
  fi
}

recover_failed_migration() {
  rollback_name=$1
  if [ -n "$rollback_name" ] && docker ps -a --format '{{.Names}}' | grep -Fxq "$rollback_name"; then
    rollback_internal "$rollback_name"
  elif docker ps -a --format '{{.Names}}' | grep -Fxq "$CONTAINER"; then
    status=$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || true)
    [ "$status" = "running" ] || docker start "$CONTAINER" >/dev/null || true
  fi
}

verify_replacement() {
  output="$EVIDENCE_ROOT/replacement.inspect.json"
  temporary=$(mktemp "$LOCAL_ROOT/.replacement-inspect.XXXXXX")
  docker inspect "$CONTAINER" >"$temporary"
  python3 - "$temporary" <<'PY'
import json,sys
p=sys.argv[1]; d=json.load(open(p))[0]; json.dump(d,open(p,"w"))
PY
  python3 "$HELPER" validate-replacement-inspect "$temporary" "$(volume_name)" "$REPO_ROOT"
  python3 - "$temporary" "$output" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); c=d.get("Config") or {}; c["Env"]=[x.split("=",1)[0]+"=[redacted]" for x in c.get("Env") or []]; d["Config"]=c
json.dump(d,open(sys.argv[2],"w"),indent=2,sort_keys=True)
PY
  python3 -c 'from pathlib import Path; Path(__import__("sys").argv[1]).unlink(missing_ok=True)' "$temporary"
  docker exec "$CONTAINER" sh -c 'test -f /config/data/library.db && test -f /config/data/authentication.db && test -r /media-router-test/movies && test -r /media-router-test/series; ! touch /media-router-test/movies/.write-test 2>/dev/null; ! touch /media-router-test/series/.write-test 2>/dev/null'
  python3 - "$SERVER_ID" "$VERSION" <<'PY'
import json,sys,time,urllib.request
expected,version=sys.argv[1:3]
deadline=time.monotonic()+120
while True:
    try:
        with urllib.request.urlopen("http://127.0.0.1:8597/System/Info/Public",timeout=5) as r:
            data=json.load(r)
        if data.get("Id") != expected or data.get("Version") != version:
            raise SystemExit("replacement Emby server identity or version mismatch")
        # Emby 4.9.5 may omit this field (or return null) from the public
        # endpoint. Reject an explicit incomplete state; the config-database
        # checks and authenticated MediaRouter connection test below provide
        # the configured-state proof when the public field is unavailable.
        if data.get("StartupWizardCompleted") is False:
            raise SystemExit("replacement Emby setup is incomplete")
        print(json.dumps({"server_id":data.get("Id"),"server_name":data.get("ServerName"),"version":data.get("Version")},sort_keys=True))
        break
    except Exception:
        if time.monotonic() >= deadline: raise
        time.sleep(2)
PY
  python3 - "$SERVER_ID" "$VERSION" <<'PY'
import json,sys,urllib.request
expected,version=sys.argv[1:3]
req=urllib.request.Request("http://127.0.0.1:18088/api/integrations/emby/test",data=b"",method="POST")
with urllib.request.urlopen(req,timeout=15) as r: data=json.load(r)
if not data.get("success") or data.get("server_id") != expected or data.get("server_version") != version:
    raise SystemExit("MediaRouter cannot verify the expected replacement Emby identity")
print(json.dumps({"success":True,"server_id":data.get("server_id"),"server_name":data.get("server_name"),"server_version":data.get("server_version")},sort_keys=True))
PY
}

command=${1:-}; [ -n "$command" ] || usage; shift || true
case "$command" in
  init)
    mkdir -p "$LOCAL_ROOT" "$BACKUP_ROOT" "$EVIDENCE_ROOT"
    chmod 700 "$LOCAL_ROOT" "$BACKUP_ROOT" "$EVIDENCE_ROOT"
    [ ! -L "$ENV_FILE" ] || { echo "Local env may not be a symlink." >&2; exit 1; }
    if [ ! -e "$ENV_FILE" ]; then
      umask 077
      {
        echo "EMBY_TEST_CONFIG_VOLUME=emby-mac-test-config-v1"
        echo "EMBY_TEST_MOVIES_PATH=$REPO_ROOT/.local/mac-mini/outputs/movies"
        echo "EMBY_TEST_SERIES_PATH=$REPO_ROOT/.local/mac-mini/outputs/series"
      } >"$ENV_FILE"
    fi
    chmod 600 "$ENV_FILE"
    render >/dev/null
    echo "Initialized managed test Emby configuration."
    ;;
  config) cat "$(render)" ;;
  safety-check) render >/dev/null; echo "Managed Emby safety checks passed." ;;
  status) ensure_initialized; compose ps -a; docker ps -a --filter name=MacEmbyTester --format 'name={{.Names}} id={{.ID}} status={{.Status}}' ;;
  backup)
    [ "$#" -eq 2 ] && [ "$1" = "--deployment" ] || usage
    case "$2" in
      legacy) ensure_initialized; backup_stopped ;;
      managed) managed_backup ;;
      *) usage ;;
    esac
    ;;
  clone-config) [ "$#" -eq 1 ] || usage; ensure_initialized; clone_from_backup "$1" ;;
  replace)
    [ "${1:-}" = "--confirm" ] && [ "${2:-}" = "emby-mac-test-replace" ] || usage
    ensure_initialized; render >/dev/null; original_guard
    rollback_name="MacEmbyTester-rollback-$(date -u +%Y%m%d-%H%M%S)"
    [ -z "$(docker ps -a --format '{{.Names}}' | grep -Fx "$rollback_name" || true)" ] || { echo "Rollback name collision." >&2; exit 1; }
    migration_complete=false
    trap 'if [ "$migration_complete" != true ]; then recover_failed_migration "$rollback_name"; fi' EXIT HUP INT TERM
    docker stop --time 60 "$CONTAINER" >/dev/null
    archive=$(backup_stopped)
    clone_from_backup "$archive"
    docker rename "$CONTAINER" "$rollback_name"
    if ! render >/dev/null || ! compose up -d "$SERVICE" || ! verify_replacement; then
      echo "Replacement validation failed; restoring the retained original container." >&2
      rollback_internal "$rollback_name"
      exit 1
    fi
    replacement_id=$(docker inspect -f '{{.Id}}' "$CONTAINER")
    python3 - "$STATE_FILE" "$rollback_name" "$archive" "$replacement_id" "$(volume_name)" <<'PY'
import json,sys
keys=("rollback_container","backup_archive","replacement_id","config_volume")
with open(sys.argv[1],"w") as f: json.dump(dict(zip(keys,sys.argv[2:])),f,indent=2,sort_keys=True); f.write("\n")
PY
    chmod 600 "$STATE_FILE"
    migration_complete=true
    trap - EXIT HUP INT TERM
    echo "Managed test Emby replacement passed. Original retained as $rollback_name"
    ;;
  verify) ensure_initialized; verify_replacement ;;
  rollback)
    [ "${1:-}" = "--confirm" ] && [ "${2:-}" = "emby-mac-test-rollback" ] || usage
    [ -f "$STATE_FILE" ] || { echo "Replacement state is missing." >&2; exit 1; }
    [ ! -L "$STATE_FILE" ] && [ -f "$STATE_FILE" ] && [ "$(stat -f %Lp "$STATE_FILE")" = "600" ] || { echo "Replacement state is unsafe." >&2; exit 1; }
    rollback_name=$(python3 -c 'import json,re,sys; v=json.load(open(sys.argv[1]))["rollback_container"]; assert re.fullmatch(r"MacEmbyTester-rollback-[0-9]{8}-[0-9]{6}",v); print(v)' "$STATE_FILE")
    temporary=$(mktemp "$LOCAL_ROOT/.rollback-inspect.XXXXXX")
    docker inspect "$rollback_name" >"$temporary"
    python3 - "$temporary" <<'PY'
import json,sys
p=sys.argv[1]; d=json.load(open(p))[0]; json.dump(d,open(p,"w"))
PY
    python3 "$HELPER" validate-original-inspect "$temporary" "$EXPECTED_ORIGINAL_ID" "$rollback_name"
    python3 -c 'from pathlib import Path; import sys; Path(sys.argv[1]).unlink(missing_ok=True)' "$temporary"
    rollback_internal "$rollback_name"
    echo "Restored the retained original test Emby container."
    ;;
  logs) ensure_initialized; compose logs --tail 200 "$SERVICE" ;;
  *) usage ;;
esac
